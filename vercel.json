{
  "version": 2,
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/Home.js",
      "dest": "/Home.js"
    },
    {
      "src": "/Home.css",
      "dest": "/Home.css"
    },
    {
      "src": "/supabase.js",
      "dest": "/supabase.js"
    },
    {
      "src": "/MentoriCélula/Editor/(.*)",
      "dest": "/MentoriCélula/Editor/$1"
    },
    {
      "src": "/MentoriCélula/Viewer/(.*)",
      "dest": "/MentoriCélula/Viewer/$1"
    }
  ]
}